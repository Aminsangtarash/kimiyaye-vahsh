{
  "name": "kimiyaye-vahsh",
  "private": true,
  "version": "0.1.0",
  "description": "Kimiyaye Vahsh — card game monorepo",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "dev:server": "pnpm --filter @kv/game-server dev",
    "dev:web": "pnpm --filter @kv/web dev",
    "dev": "pnpm run dev:server & pnpm run dev:web"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.18.1"
  }
}
