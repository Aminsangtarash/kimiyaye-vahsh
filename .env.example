# Kimiyaye Vahsh — local development (no secrets)

# Game server
GAME_SERVER_PORT=4010
GAME_SERVER_HOST=0.0.0.0
NODE_ENV=development

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Session / tickets (use long random strings in real deployments — min 32 chars)
GAME_TICKET_SECRET=change-me-to-a-long-random-string-min-32-chars
SESSION_SECRET=change-me-session-secret-min-32-chars

# Reconnect & inactivity (milliseconds)
RECONNECT_GRACE_MS=60000
INACTIVITY_TIMEOUT_MS=60000

# Match audit directory (file persistence)
KV_PERSIST_DIR=.data/matches

# Dev admin match viewer key (ignored in production)
KV_ADMIN_KEY=dev-admin

# PostgreSQL (optional — server runs with file audit without DB)
DATABASE_URL=postgresql://kv:kv@localhost:5432/kimiyaye_vahsh

# Redis (optional — omit for in-memory-only MVP)
REDIS_URL=

# Main website integration (optional)
MAIN_SITE_JWT_ISSUER=
MAIN_SITE_JWT_PUBLIC_KEY=
REWARD_WEBHOOK_URL=
REWARD_WEBHOOK_HMAC_SECRET=

# Web client (bake at Vite build time)
VITE_GAME_SERVER_URL=http://localhost:4010

# Load test rooms (optional)
KV_LOAD_ROOMS=50
