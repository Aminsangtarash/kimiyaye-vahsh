# Kimiyaye Vahsh — local development (no secrets)

GAME_SERVER_PORT=4010
GAME_SERVER_HOST=0.0.0.0
NODE_ENV=development

CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

GAME_TICKET_SECRET=change-me-to-a-long-random-string-min-32-chars
SESSION_SECRET=change-me-session-secret-min-32-chars

RECONNECT_GRACE_MS=60000
INACTIVITY_TIMEOUT_MS=60000

# V2 lobby / bots
MATCH_START_COUNTDOWN_MS=3000
QUICK_MATCH_BOT_FILL_AFTER_MS=45000
BOT_ACTION_DELAY_MS=700

# Legacy specials OFF for V2 playable mode
V2_SPECIAL_CARDS_ENABLED=false

# Impact weights
IMPACT_TRICK_WON=10
IMPACT_SUCCESSFUL_SPECIAL=10
IMPACT_LEGENDARY_COUNTER=20
IMPACT_TEAM_ASSIST=10
IMPACT_HUMAN_TIMEOUT=-5

REWARD_SKIP_BOT_MATCHES=true

KV_PERSIST_DIR=.data/matches
KV_ADMIN_KEY=dev-admin

DATABASE_URL=postgresql://kv:kv@localhost:5432/kimiyaye_vahsh
REDIS_URL=

MAIN_SITE_JWT_ISSUER=
MAIN_SITE_JWT_PUBLIC_KEY=
REWARD_WEBHOOK_URL=
REWARD_WEBHOOK_HMAC_SECRET=

VITE_GAME_SERVER_URL=http://localhost:4010
KV_LOAD_ROOMS=50
